# Copy to .env.local for local dev. Never commit the real .env.local.

# The FastAPI backend's base URL. In Docker Compose this would be the
# api service name; for local dev against a locally-run backend, localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Must match the backend's JWT_SECRET if this app ever verifies tokens
# itself (currently it doesn't -- verification happens server-side by
# FastAPI on every request; middleware.ts here only checks for the
# cookie's PRESENCE, not its validity, to keep this file simple -- see
# the comment in middleware.ts for what that means in practice).
